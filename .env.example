# Prisma datasource. SQLite by default so the MVP runs with no external services.
# To use PostgreSQL, change `provider` in prisma/schema.prisma to "postgresql"
# and point this at your instance.
DATABASE_URL="file:./dev.db"

# Anthropic API credentials for the LLM layer (interpreter / decision / renderer / evaluator).
# Omit to run the engine with the deterministic stub LLM provider.
ANTHROPIC_API_KEY=""

# Overrides the default model id (claude-opus-5).
SCENARIA_MODEL="claude-opus-5"

# "anthropic" (default when a key is present) or "stub".
SCENARIA_LLM_PROVIDER=""

# Exposes hidden simulation state through the debug API and UI panel.
SCENARIA_DEBUG="1"
